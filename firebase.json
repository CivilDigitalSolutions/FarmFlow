{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/donate", "function": { "functionId": "donations", "region": "europe-west2" } },
      { "source": "/api/stripe/webhook", "function": { "functionId": "donations", "region": "europe-west2" } },
      { "source": "/api/**", "function": { "functionId": "web", "region": "europe-west2" } },
      { "source": "/listing", "function": { "functionId": "web", "region": "europe-west2" } },
      { "source": "/listing/**", "function": { "functionId": "web", "region": "europe-west2" } },
      { "source": "/seller/**", "function": { "functionId": "web", "region": "europe-west2" } },
      { "source": "/sitemap-marketplace.xml", "function": { "functionId": "web", "region": "europe-west2" } },
      { "source": "/signin", "destination": "/index.html" },
      { "source": "/account", "destination": "/index.html" },
      { "source": "/account/setup", "destination": "/index.html" },
      { "source": "/donate", "destination": "/index.html" },
      { "source": "/donate/thanks", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=()" }
        ]
      },
      { "source": "/.well-known/assetlinks.json", "headers": [{ "key": "Content-Type", "value": "application/json" }] },
      { "source": "/app/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
